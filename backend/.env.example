# Copy to .env and adjust.

# Application
APP_NAME="Weather Tracking & Analysis Dashboard"
ENVIRONMENT=development
DEBUG=true

# Database (SQLAlchemy URL). Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./weather.db

# CORS: comma-separated list of allowed origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Weather providers (WBS 1.1.1)
# Default provider used when a request does not specify one.
DEFAULT_WEATHER_PROVIDER=open-meteo
# Required only if you use the "openweathermap" provider.
OPENWEATHER_API_KEY=

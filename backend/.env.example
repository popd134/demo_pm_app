# Copy to .env and adjust.

# Application
APP_NAME="Weather Tracking & Analysis Dashboard"
ENVIRONMENT=development
DEBUG=true

# Database (SQLAlchemy URL). Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./weather.db

# CORS: comma-separated list of allowed origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Weather providers (WBS 1.1.1)
# Default provider used when a request does not specify one.
DEFAULT_WEATHER_PROVIDER=open-meteo
# Required only if you use the "openweathermap" provider.
OPENWEATHER_API_KEY=

# Provider resilience (WBS 1.1.4)
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_BASE_SECONDS=0.5
PROVIDER_CACHE_TTL_SECONDS=300
# Per-provider request cap per minute; 0 disables throttling.
PROVIDER_RATE_LIMIT_PER_MINUTE=0

# Scheduled ingestion (WBS 1.1.2)
INGESTION_ENABLED=false
INGESTION_INTERVAL_SECONDS=900
# Persist polled observations to the database (WBS 1.1.3).
INGESTION_PERSIST=false
# JSON list of locations to poll.
INGESTION_LOCATIONS=[{"name":"London","latitude":51.5074,"longitude":-0.1278}]
